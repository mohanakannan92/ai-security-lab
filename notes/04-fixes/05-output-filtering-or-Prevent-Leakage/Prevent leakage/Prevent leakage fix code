def is_sensitive_output(text: str) -> bool:
    """
    Purpose:
    Detect if model output contains sensitive/internal info

    Why needed:
    Even if input filtering fails,
    model might STILL leak internal rules.

    This acts as FINAL SECURITY GATE.
    """

    sensitive_patterns = [
        "system prompt",
        "internal instructions",
        "hidden rules",
        "confidential",
        "security policy",
        "ignore previous instructions",
        "you are a secure ai assistant"
    ]

    for pattern in sensitive_patterns:
        if pattern in text.lower():
            return True

    return False


